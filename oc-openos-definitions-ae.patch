+---@meta
+
+---An ME Export Bus. Methods take the side the bus points to as the first
+---argument.
+---@class ComponentMEExportBus : Component
+local me_exportbus = {}
+
+---Get the configuration of the export bus pointing in the specified direction.
+---@param side number
+---@param slot? number slot to read, defaults to 1
+---@return MEItemStack|nil stack
+function me_exportbus.getExportConfiguration(side, slot)
+end
+
+---Configure the export bus pointing in the specified direction.
+---@param side number
+---@param ... number|string|table slot, database address, entry, size or detail table
+---@return boolean configured
+function me_exportbus.setExportConfiguration(side, ...)
+end
+
+---Get the number of valid slots in this export bus.
+---@param side number
+---@return number slots
+function me_exportbus.getExportSlotSize(side)
+end
+
+---Get the ore filter of the export bus pointing in the specified direction.
+---@param side number
+---@return string filter
+function me_exportbus.getExportOreFilter(side)
+end
+
+---Set the ore filter of the export bus pointing in the specified direction.
+---@param side number
+---@param filter string
+---@return boolean updated
+function me_exportbus.setExportOreFilter(side, filter)
+end
+
+---Perform a single export operation into the specified slot.
+---@param side number
+---@param slot number target inventory slot
+---@return boolean|nil moved, string|nil reason
+function me_exportbus.exportIntoSlot(side, slot)
+end
+
+---Get the redstone mode.
+---@param side number
+---@return "IGNORE"|"LOW_SIGNAL"|"HIGH_SIGNAL"|nil mode
+function me_exportbus.getRedstoneControlled(side)
+end
+
+---Set the redstone mode.
+---@param side number
+---@param value "IGNORE"|"LOW_SIGNAL"|"HIGH_SIGNAL"
+---@return boolean updated
+function me_exportbus.setRedstoneControlled(side, value)
+end
+
+---Get the fuzzy mode.
+---@param side number
+---@return "IGNORE_ALL"|"PERCENT_99"|"PERCENT_75"|"PERCENT_50"|"PERCENT_25"|"PERCENT_10"|"PERCENT_1"|nil mode
+function me_exportbus.getFuzzyMode(side)
+end
+
+---Set the fuzzy mode.
+---@param side number
+---@param value "IGNORE_ALL"|"PERCENT_99"|"PERCENT_75"|"PERCENT_50"|"PERCENT_25"|"PERCENT_10"|"PERCENT_1"
+---@return boolean updated
+function me_exportbus.setFuzzyMode(side, value)
+end
+
+---Get whether only craftable items are exported.
+---@param side number
+---@return boolean enabled
+function me_exportbus.getCraftOnly(side)
+end
+
+---Set whether only craftable items are exported.
+---@param side number
+---@param value boolean
+---@return boolean updated
+function me_exportbus.setCraftOnly(side, value)
+end
+
+---Get the scheduling mode.
+---@param side number
+---@return "DEFAULT"|"ROUNDROBIN"|nil mode
+function me_exportbus.getSchedulingMode(side)
+end
+
+---Set the scheduling mode.
+---@param side number
+---@param value "DEFAULT"|"ROUNDROBIN"
+---@return boolean updated
+function me_exportbus.setSchedulingMode(side, value)
+end
