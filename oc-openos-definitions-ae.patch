diff --git a/library/component/me_cellworkbench.d.lua b/library/component/me_cellworkbench.d.lua
new file mode 100644
index 0000000..c16af20
--- /dev/null
+++ b/library/component/me_cellworkbench.d.lua
@@ -0,0 +1,71 @@
+---@meta
+
+---An ME Cell Workbench for configuring storage cells.
+---@class ComponentMECellWorkbench : Component
+local me_cellworkbench = {}
+
+---Returns whether a storage cell is currently inserted.
+---@return boolean inserted
+function me_cellworkbench.hasCell()
+end
+
+---Returns the inserted cell's type (`"item"`, `"fluid"`, `"essentia"`, ...).
+---@return string|nil cellType
+function me_cellworkbench.getCellType()
+end
+
+---Returns details about the inserted cell item itself.
+---@return MEItemStack|nil cell
+function me_cellworkbench.getCell()
+end
+
+---Returns every non-empty partition slot as a table keyed by slot number.
+---@return table<number, MEItemStack> partitions
+function me_cellworkbench.getPartition()
+end
+
+---Set the partition in the given slot. Omit the item to clear the slot.
+---@param slot number 1-based partition slot
+---@param item? table item stack description
+---@return boolean updated
+function me_cellworkbench.setPartition(slot, item)
+end
+
+---Clear every partition slot on the inserted cell.
+---@return boolean cleared
+function me_cellworkbench.clearPartitions()
+end
+
+---Returns the cell's restriction as `(types, amount)`. `(0, 0)` means unrestricted.
+---@return number types, number amount
+function me_cellworkbench.getRestriction()
+end
+
+---Set the cell's restriction. `(0, 0)` means unrestricted.
+---@param types number maximum number of types
+---@param amount number maximum amount per type
+---@return boolean updated
+function me_cellworkbench.setRestriction(types, amount)
+end
+
+---Returns the inserted cell's ore filter string, or an empty string if unset.
+---@return string filter
+function me_cellworkbench.getOreFilter()
+end
+
+---Set the inserted cell's ore filter string.
+---@param filter string
+---@return boolean updated
+function me_cellworkbench.setOreFilter(filter)
+end
+
+---Returns the workbench's copy mode.
+---@return "clear"|"keep" mode
+function me_cellworkbench.getCopyMode()
+end
+
+---Set the workbench's copy mode.
+---@param mode "clear"|"keep"
+---@return boolean updated
+function me_cellworkbench.setCopyMode(mode)
+end
