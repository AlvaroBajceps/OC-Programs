diff --git a/library/component/me_interface.d.lua b/library/component/me_interface.d.lua
new file mode 100644
index 0000000..b2b0ab8
--- /dev/null
+++ b/library/component/me_interface.d.lua
@@ -0,0 +1,182 @@
+---@meta
+
+---An ME Interface (block or part) exposes the ME network and interface
+---configuration/pattern methods to the computer.
+---
+---Block interfaces take the slot as the first argument. Part interfaces take
+---the side as the first argument, followed by the slot.
+---@class ComponentMEInterface : ComponentMENetwork
+local me_interface = {}
+
+---Get the configuration of the interface.
+---@param slot? number slot to read, defaults to 1
+---@return MEItemStack|nil stack
+---@overload fun(side: number, slot?: number): MEItemStack|nil
+function me_interface.getInterfaceConfiguration(slot)
+end
+
+---Configure the interface.
+---
+---Accepted forms:
+---* `setInterfaceConfiguration([slot,] database, entry[, size])`
+---* `setInterfaceConfiguration([slot,] detail)`
+---* part interface: `setInterfaceConfiguration(side[, slot], ...)`
+---@param ... number|string|table
+---@return boolean configured
+function me_interface.setInterfaceConfiguration(...)
+end
+
+---Get the pattern in the given interface slot.
+---@param slot? number slot to read, defaults to 1
+---@return MEPatternStack|nil pattern
+---@overload fun(side: number, slot?: number): MEPatternStack|nil
+function me_interface.getInterfacePattern(slot)
+end
+
+---Set the pattern input at the given index.
+---@param ... number|string|table
+---@return boolean configured
+function me_interface.setInterfacePatternInput(...)
+end
+
+---Set the pattern output at the given index.
+---@param ... number|string|table
+---@return boolean configured
+function me_interface.setInterfacePatternOutput(...)
+end
+
+---Store the pattern input at the given index to a database entry.
+---@param ... number|string
+---@return boolean stored
+function me_interface.storeInterfacePatternInput(...)
+end
+
+---Store the pattern output at the given index to a database entry.
+---@param ... number|string
+---@return boolean stored
+function me_interface.storeInterfacePatternOutput(...)
+end
+
+---Clear the pattern input at the given index.
+---@param ... number
+---@return boolean cleared
+function me_interface.clearInterfacePatternInput(...)
+end
+
+---Clear the pattern output at the given index.
+---@param ... number
+---@return boolean cleared
+function me_interface.clearInterfacePatternOutput(...)
+end
+
+---Get whether blocking mode is enabled.
+---@param side? number side of a part interface, omit for a block interface
+---@return boolean enabled
+function me_interface.getBlockingMode(side)
+end
+
+---Set whether blocking mode is enabled.
+---@param side number side of a part interface
+---@param value boolean
+---@return boolean updated
+---@overload fun(value: boolean): boolean
+function me_interface.setBlockingMode(side, value)
+end
+
+---Get whether smart blocking is enabled.
+---@param side? number side of a part interface, omit for a block interface
+---@return boolean enabled
+function me_interface.getSmartBlock(side)
+end
+
+---Set whether smart blocking is enabled.
+---@param side number side of a part interface
+---@param value boolean
+---@return boolean updated
+---@overload fun(value: boolean): boolean
+function me_interface.setSmartBlock(side, value)
+end
+
+---Get whether the interface is visible in interface terminals.
+---@param side? number side of a part interface, omit for a block interface
+---@return boolean visible
+function me_interface.getInterfaceTerminal(side)
+end
+
+---Set whether the interface is visible in interface terminals.
+---@param side number side of a part interface
+---@param value boolean
+---@return boolean updated
+---@overload fun(value: boolean): boolean
+function me_interface.setInterfaceTerminal(side, value)
+end
+
+---Get the insertion mode.
+---@param side? number side of a part interface, omit for a block interface
+---@return "DEFAULT"|"PREFER_EMPTY"|"ONLY_EMPTY"|nil mode
+function me_interface.getInsertionMode(side)
+end
+
+---Set the insertion mode.
+---@param side number side of a part interface
+---@param value "DEFAULT"|"PREFER_EMPTY"|"ONLY_EMPTY"
+---@return boolean updated
+---@overload fun(value: "DEFAULT"|"PREFER_EMPTY"|"ONLY_EMPTY"): boolean
+function me_interface.setInsertionMode(side, value)
+end
+
+---Get the advanced blocking mode.
+---@param side? number side of a part interface, omit for a block interface
+---@return "DEFAULT"|"BLOCK_ON_ALL"|nil mode
+function me_interface.getAdvancedBlockingMode(side)
+end
+
+---Set the advanced blocking mode.
+---@param side number side of a part interface
+---@param value "DEFAULT"|"BLOCK_ON_ALL"
+---@return boolean updated
+---@overload fun(value: "DEFAULT"|"BLOCK_ON_ALL"): boolean
+function me_interface.setAdvancedBlockingMode(side, value)
+end
+
+---Get the crafting lock mode.
+---@param side? number side of a part interface, omit for a block interface
+---@return "NONE"|"LOCK_UNTIL_PULSE"|"LOCK_WHILE_HIGH"|"LOCK_WHILE_LOW"|nil mode
+function me_interface.getLockCraftingMode(side)
+end
+
+---Set the crafting lock mode.
+---@param side number side of a part interface
+---@param value "NONE"|"LOCK_UNTIL_PULSE"|"LOCK_WHILE_HIGH"|"LOCK_WHILE_LOW"
+---@return boolean updated
+---@overload fun(value: "NONE"|"LOCK_UNTIL_PULSE"|"LOCK_WHILE_HIGH"|"LOCK_WHILE_LOW"): boolean
+function me_interface.setLockCraftingMode(side, value)
+end
+
+---Get whether pattern optimization is enabled.
+---@param side? number side of a part interface, omit for a block interface
+---@return boolean enabled
+function me_interface.getPatternOptimization(side)
+end
+
+---Set whether pattern optimization is enabled.
+---@param side number side of a part interface
+---@param value boolean
+---@return boolean updated
+---@overload fun(value: boolean): boolean
+function me_interface.setPatternOptimization(side, value)
+end
+
+---Get the fuzzy mode.
+---@param side? number side of a part interface, omit for a block interface
+---@return "IGNORE_ALL"|"PERCENT_99"|"PERCENT_75"|"PERCENT_50"|"PERCENT_25"|"PERCENT_10"|"PERCENT_1"|nil mode
+function me_interface.getFuzzyMode(side)
+end
+
+---Set the fuzzy mode.
+---@param side number side of a part interface
+---@param value "IGNORE_ALL"|"PERCENT_99"|"PERCENT_75"|"PERCENT_50"|"PERCENT_25"|"PERCENT_10"|"PERCENT_1"
+---@return boolean updated
+---@overload fun(value: "IGNORE_ALL"|"PERCENT_99"|"PERCENT_75"|"PERCENT_50"|"PERCENT_25"|"PERCENT_10"|"PERCENT_1"): boolean
+function me_interface.setFuzzyMode(side, value)
+end
diff --git a/library/component/me_interface_terminal.d.lua b/library/component/me_interface_terminal.d.lua
new file mode 100644
index 0000000..6abfbec
--- /dev/null
+++ b/library/component/me_interface_terminal.d.lua
@@ -0,0 +1,37 @@
+---@meta
+
+---An ME Interface Terminal for listing interfaces and moving patterns between
+---them.
+---@class ComponentMEInterfaceTerminal : Component
+local me_interface_terminal = {}
+
+---Returns a list of all interfaces visible to the terminal.
+---@return MEInterfaceViewableArray interfaces
+function me_interface_terminal.getInterfaces()
+end
+
+---Returns a list of interfaces with the specified display name.
+---@param filter string interface display name
+---@return MEInterfaceViewableArray interfaces
+function me_interface_terminal.getInterfacesByName(filter)
+end
+
+---Returns a list of interfaces at the specified location.
+---@param location MELocation
+---@param side? number|string side the interface is attached to
+---@return MEInterfaceViewableArray interfaces
+function me_interface_terminal.getInterfacesByLocation(location, side)
+end
+
+---Send a pattern from a source interface to a target interface.
+---@param source table `{ location: MELocation, slot: number }`
+---@param target table `{ location: MELocation, slot?: number }`
+---@return boolean success, number|string result target slot or error message
+function me_interface_terminal.send(source, target)
+end
+
+---Execute multiple pattern transfers in one batch.
+---@param tasks table[] array of `{ source = ..., target = ... }` entries
+---@return table[] results array of `[success, slotOrError]` results
+function me_interface_terminal.sendBatch(tasks)
+end
diff --git a/library/component/me_network.d.lua b/library/component/me_network.d.lua
new file mode 100644
index 0000000..27f53d8
--- /dev/null
+++ b/library/component/me_network.d.lua
@@ -0,0 +1,285 @@
+---@meta
+
+---An item stack stored in an ME network.
+---@class MEItemStack
+---@field name string unlocalized item name, e.g. `minecraft:stone`
+---@field label string display name
+---@field damage number item damage/metadata value
+---@field maxDamage number maximum damage value
+---@field size number stack size in the network
+---@field maxSize number maximum stack size
+---@field hasTag boolean whether the stack has an NBT tag
+---@field id? number numeric item ID (only when `insertIdsInConverters` is enabled)
+---@field oreNames? string[] ore dictionary names
+---@field lore? string item lore
+---@field tag? string compressed NBT data
+---@field enchantments? table[] enchantment descriptions
+---@field isCraftable? boolean whether the item is craftable
+
+---An encoded pattern stored in an ME network or interface.
+---@class MEPatternStack : MEItemStack
+---@field inputs (MEItemStack|MEFluidStack)[] Array of input ingredients
+---@field outputs (MEItemStack|MEFluidStack)[] Array of output results
+
+---A fluid stack stored in an ME network.
+---@class MEFluidStack
+---@field name string fluid name
+---@field label string display name
+---@field amount number amount in millibuckets
+---@field hasTag boolean whether the stack has an NBT tag
+---@field id? number numeric fluid ID (only when `insertIdsInConverters` is enabled)
+---@field size? number stack size in the network
+---@field isCraftable? boolean whether the fluid is craftable
+
+---Information about a crafting CPU.
+---@class MECpuInfo
+---@field name string CPU name
+---@field storage number available storage in bytes
+---@field coprocessors number number of coprocessors
+---@field busy boolean whether the CPU is currently crafting
+---@field cpu MECpu handle for querying and cancelling the CPU's job
+
+---A crafting CPU handle returned by `getCpus`.
+---@class MECpu
+local cpu = {}
+
+---Cancel this CPU's current crafting job.
+---@return boolean cancelled
+function cpu.cancel()
+end
+
+---Returns whether the CPU is active.
+---@return boolean active
+function cpu.isActive()
+end
+
+---Returns whether the CPU is busy.
+---@return boolean busy
+function cpu.isBusy()
+end
+
+---Get the items currently being crafted.
+---@return MEItemStack[] items
+function cpu.activeItems()
+end
+
+---Get the items waiting to be crafted.
+---@return MEItemStack[] items
+function cpu.pendingItems()
+end
+
+---Get the items stored in the CPU.
+---@return MEItemStack[] items
+function cpu.storedItems()
+end
+
+---Get the final output of the current crafting job.
+---@return MEItemStack|nil output, string|nil reason
+function cpu.finalOutput()
+end
+
+---A crafting request handle returned by `MECraftable.request`.
+---@class MECraftingStatus
+local status = {}
+
+---Returns whether the crafting request is still being computed.
+---@return boolean computing
+function status.isComputing()
+end
+
+---Returns whether the crafting request has failed.
+---@return boolean failed, string|nil reason
+function status.hasFailed()
+end
+
+---Returns whether the crafting request has been cancelled.
+---@return boolean cancelled, string|nil reason
+function status.isCanceled()
+end
+
+---Returns whether the crafting request is done.
+---@return boolean done, string|nil reason
+function status.isDone()
+end
+
+---Cancel the crafting request.
+---Only available in upstream OpenComputers; the GTNH fork does not provide it.
+---@return boolean|nil cancelled, string|nil reason
+function status.cancel()
+end
+
+---A craftable item returned by `getCraftables` or `getCraftable`.
+---@class MECraftable
+local craftable = {}
+
+---Returns the item stack representation of the crafting result.
+---@return MEItemStack stack
+function craftable.getStack()
+end
+
+---Returns the number of requests in progress for this item.
+---Only available in upstream OpenComputers; the GTNH fork does not provide it.
+---@return number requests
+function craftable.requesting()
+end
+
+---Request this item to be crafted.
+---@param amount? number amount to craft, defaults to 1
+---@param prioritizePower? boolean defaults to true
+---@param cpuName? string name of the CPU to use, defaults to any CPU
+---@return MECraftingStatus|nil status, string|nil reason
+function craftable.request(amount, prioritizePower, cpuName)
+end
+
+---Iterator over the items stored in an ME network.
+---@class MEItemNetworkContents
+---@operator call:MEItemStack|nil
+local contents = {}
+
+---A location in the world.
+---@class MELocation
+---@field x number
+---@field y number
+---@field z number
+---@field dimId? number dimension ID
+
+---Information about an ME interface returned by an interface terminal.
+---@class MEInterfaceViewable
+---@field name string interface display name
+---@field location MELocation interface location
+---@field side number side the interface part is attached to
+---@field patterns table<number, MEItemStack> configured patterns, keyed by slot
+
+---A list of interfaces returned by `me_interface_terminal`.
+---@class MEInterfaceViewableArray
+---@operator call:MEInterfaceViewable|nil
+local viewables = {}
+
+---Reset the iterator index so the next call returns the first element.
+function viewables.reset()
+end
+
+---Returns the number of elements in the list.
+---@return number count
+function viewables.count()
+end
+
+---Returns all interface information as a table.
+---@param includePatterns? boolean include pattern stacks, defaults to false
+---@return MEInterfaceViewable[] interfaces
+function viewables.getAll(includePatterns)
+end
+
+---Common API shared by AE network components (`me_controller`, `me_interface`
+---and the `upgrade_me` component).
+---@class ComponentMENetwork : Component
+local network = {}
+
+---Get a list of tables representing the available CPUs in the network.
+---@return MECpuInfo[] cpus
+function network.getCpus()
+end
+
+---Get a known recipe. This can be used to issue crafting requests.
+---@param detail table item stack description
+---@param type string AE stack type, e.g. `"item"` or `"fluid"`
+---@return MECraftable|nil craftable
+function network.getCraftable(detail, type)
+end
+
+---Get a list of known recipes that can be used to issue crafting requests.
+---@param filter? table<string, any> optional field filter
+---@return MECraftable[] craftables
+function network.getCraftables(filter)
+end
+
+---Get a list of the stored items in the network.
+---@param filter? table<string, any> optional field filter
+---@return MEItemStack[] items
+function network.getItemsInNetwork(filter)
+end
+
+---Get a stored item by its name or numeric ID.
+---@param nameOrId string|number unlocalized item name or numeric ID
+---@param damage? number item damage/metadata
+---@param nbt? string SNBT string
+---@return MEItemStack|nil item
+---@overload fun(detail: table): MEItemStack|nil
+function network.getItemInNetwork(nameOrId, damage, nbt)
+end
+
+---Get stored items matching an array of item IDs or names.
+---@param filter table<number, string|number> item IDs or names
+---@return MEItemStack[] items
+function network.getItemsInNetworkById(filter)
+end
+
+---Get a stored fluid by its name or description.
+---@param nameOrDetail string|table fluid name or fluid stack description
+---@return MEFluidStack|nil fluid
+function network.getFluidInNetwork(nameOrDetail)
+end
+
+---Get an iterator over the items in the network.
+---@return MEItemNetworkContents contents
+function network.allItems()
+end
+
+---Store items matching the filter in the database with the specified address.
+---@param filter table<string, any> field filter
+---@param dbAddress string database component address
+---@param startSlot? number first database slot to use
+---@param count? number maximum number of entries to store
+---@return boolean stored
+function network.store(filter, dbAddress, startSlot, count)
+end
+
+---Get a list of the stored fluids in the network.
